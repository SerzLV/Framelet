<Window x:Class="Framelet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Framelet"
        Title="Framelet" Icon="Assets/Framelet.ico" Width="1024" Height="754"
        MinWidth="875" MinHeight="615" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" StateChanged="OnStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="10" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource Window}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource TitleBar}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="19,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="Assets/Framelet.ico" Width="30" Height="30" SnapsToDevicePixels="True"/>
                        <TextBlock Text="Framelet" FontSize="20" FontWeight="Bold" Margin="9,-2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{DynamicResource Ui.Settings}" AutomationProperties.Name="{DynamicResource Ui.Settings}"><Path Style="{StaticResource Icon}" Data="{StaticResource SettingsIcon}" Width="16" Height="16"/></Button>
                        <Border Width="1" Height="19" Background="{StaticResource Stroke}" Margin="7,0"/>
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{DynamicResource Ui.Minimize}" AutomationProperties.Name="{DynamicResource Ui.Minimize}">
                            <Border Width="10" Height="1" Background="{StaticResource Muted}"/>
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="{DynamicResource Ui.Maximize}" AutomationProperties.Name="{DynamicResource Ui.Maximize}">
                            <Border x:Name="MaximizeGlyph" Width="10" Height="9" BorderBrush="{StaticResource Muted}" BorderThickness="1" CornerRadius="1"/>
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Click="Hide_Click" ToolTip="{DynamicResource Ui.Hide}" AutomationProperties.Name="{DynamicResource Ui.Hide}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource CloseIcon}" Width="11" Height="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          IsVisibleChanged="HistoryVisibility_Changed" ScrollChanged="HomeScroll_Changed">
                <StackPanel Margin="31,24,31,24" MaxWidth="1250">
                    <Border CornerRadius="18" BorderBrush="#34464A" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#192329" Offset="0"/><GradientStop Color="#19242B" Offset=".52"/>
                                <GradientStop Color="#1B3330" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid MinHeight="241">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.19*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="26,22,0,24" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui.CaptureHeading}" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" Margin="1,0,0,10"/>
                                <TextBlock Text="{DynamicResource Ui.CaptureHero}" FontSize="38" FontWeight="Bold" LineHeight="41" Margin="-1,0,0,9"/>
                                <TextBlock Text="{DynamicResource Ui.CaptureSub}" Style="{StaticResource MutedText}" FontSize="15" LineHeight="22"/>
                                <StackPanel Orientation="Horizontal" Margin="0,21,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="14,10" Click="Capture_Click" Tag="QuickClipboard"
                                            ToolTip="{DynamicResource Ui.QuickCapturePrompt}" AutomationProperties.Name="{DynamicResource Ui.CaptureQuickClipboard}">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource CropIcon}" />
                                            <AccessText Text="{DynamicResource Ui.CaptureQuickClipboard}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border x:Name="ClipboardKeycap" Style="{StaticResource Keycap}" Margin="11,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="PrtSc" Style="{StaticResource KeyLabel}"/>
                                    </Border>
                                </StackPanel>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Style="{StaticResource GhostButton}" Click="Capture_Click" Tag="Region" Padding="8,5"
                                            AutomationProperties.Name="{DynamicResource Ui.CaptureRegion}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource PenIcon}" Width="14" Height="14"/>
                                            <AccessText Text="{DynamicResource Ui.CaptureRegion}" Margin="6,0,0,0"/>
                                            <TextBlock x:Name="EditorRegionShortcutLabel" Text="Ctrl + Shift + 1" Foreground="{StaticResource Accent}"
                                                       FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="PasteImage_Click" Padding="8,5" Margin="4,0,0,0"
                                            Content="{DynamicResource Ui.PasteImage}" ToolTip="{DynamicResource Ui.PasteImageTip}"/>
                                </WrapPanel>
                            </StackPanel>
                            <Viewbox Grid.Column="1" MaxWidth="391" Height="225" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Margin="11,0,14,0" IsHitTestVisible="False">
                                <Canvas Width="392" Height="225">
                                    <Path Stroke="#35504F" StrokeThickness="1" Opacity=".61" Data="M11,49 H373 M11,77 H373 M11,105 H373 M11,133 H373 M11,161 H373 M11,189 H373 M37,18 V208 M65,18 V208 M93,18 V208 M121,18 V208 M149,18 V208 M177,18 V208 M205,18 V208 M233,18 V208 M261,18 V208 M289,18 V208 M317,18 V208 M345,18 V208"/>
                                    <Rectangle Canvas.Left="64" Canvas.Top="30" Width="248" Height="148" RadiusX="13" RadiusY="13" Fill="#192827" Stroke="#4A6260"/>
                                    <Canvas Canvas.Left="87" Canvas.Top="42" Width="253" Height="151">
                                        <Border Width="253" Height="151" CornerRadius="13" Background="#202B33" BorderBrush="#53676D" BorderThickness="1"/>
                                        <Path Stroke="#53676D" Data="M1,24 H252"/>
                                        <Ellipse Width="5" Height="5" Canvas.Left="12" Canvas.Top="10" Fill="#B0C2BD"/>
                                        <Ellipse Width="5" Height="5" Canvas.Left="22" Canvas.Top="10" Fill="#6A8380"/>
                                        <Ellipse Width="5" Height="5" Canvas.Left="32" Canvas.Top="10" Fill="#6A8380"/>
                                        <Rectangle Canvas.Left="12" Canvas.Top="36" Width="46" Height="102" RadiusX="5" RadiusY="5" Fill="#283B40"/>
                                        <Rectangle Canvas.Left="72" Canvas.Top="40" Width="91" Height="6" RadiusX="3" RadiusY="3" Fill="#718282"/>
                                        <Rectangle Canvas.Left="72" Canvas.Top="52" Width="54" Height="4" RadiusX="2" RadiusY="2" Fill="#4E6264"/>
                                        <Rectangle Canvas.Left="72" Canvas.Top="66" Width="168" Height="69" RadiusX="6" RadiusY="6" Fill="#304F4C"/>
                                        <Path Fill="#3C6057" Data="M73,128 L111,106 L132,112 L170,84 L205,108 L239,90 V129 Q239,134 234,134 H78 Q73,134 73,128 Z"/>
                                        <Path Stroke="#A9D88B" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M81,123 L111,105 L132,111 L170,83 L205,107 L229,94"/>
                                        <Ellipse Width="6" Height="6" Canvas.Left="167" Canvas.Top="80" Fill="#D3FA85"/>
                                    </Canvas>
                                    <Rectangle Canvas.Left="142" Canvas.Top="76" Width="178" Height="94" Stroke="#D3FA85" StrokeThickness="1.2" StrokeDashArray="3 3" Fill="#11D3FA85"/>
                                    <Path Stroke="#D3FA85" StrokeThickness="2.6" StrokeLineJoin="Round" Data="M142,87 V76 H153 M309,76 H320 V87 M320,159 V170 H309 M153,170 H142 V159"/>
                                    <Border Canvas.Left="142" Canvas.Top="54" Background="#D3FA85" CornerRadius="4" Padding="6,3">
                                        <TextBlock Text="640 × 360" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#17201A"/>
                                    </Border>
                                    <Path Canvas.Left="315" Canvas.Top="148" Fill="#E2F8C4" Stroke="#18271C" StrokeThickness="1.3" StrokeLineJoin="Round"
                                          Data="M0,0 L2,27 L9,20 L14,28 L19,25 L14,17 L23,16 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Margin="0,13,0,0">

                            <Button Style="{StaticResource BaseButton}" Click="Capture_Click" Tag="Screen" Padding="13,12" AutomationProperties.Name="{DynamicResource Ui.CaptureScreen}"
                                    HorizontalContentAlignment="Stretch" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="#24313A" CornerRadius="8" Width="35" Height="35">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource ScreenIcon}" Stroke="#D3FA85" Width="17" Height="17"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui.CaptureScreen}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{DynamicResource Ui.ScreenDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource ForwardIcon}" Grid.Column="2" Width="12" Height="12" Stroke="#818F9E" Margin="2,0,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource BaseButton}" Click="Capture_Click" Tag="Window" Padding="13,12" AutomationProperties.Name="{DynamicResource Ui.CaptureWindow}"
                                    HorizontalContentAlignment="Stretch" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="#24313A" CornerRadius="8" Width="35" Height="35">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource WindowIcon}" Stroke="#D3FA85" Width="17" Height="17"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui.CaptureWindow}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{DynamicResource Ui.WindowDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource ForwardIcon}" Grid.Column="2" Width="12" Height="12" Stroke="#818F9E" Margin="2,0,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource BaseButton}" Click="Capture_Click" Tag="Delayed" Padding="13,12" AutomationProperties.Name="{DynamicResource Ui.CaptureDelayed}"
                                    HorizontalContentAlignment="Stretch" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="#24313A" CornerRadius="8" Width="35" Height="35">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource TimerIcon}" Stroke="#D3FA85" Width="17" Height="17"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui.CaptureDelayed}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{DynamicResource Ui.DelayedDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource ForwardIcon}" Grid.Column="2" Width="12" Height="12" Stroke="#818F9E" Margin="2,0,0,0"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource BaseButton}" Click="Capture_Click" Tag="Scrolling" Padding="13,12"
                                    AutomationProperties.Name="{DynamicResource Ui.CaptureScrolling}" HorizontalContentAlignment="Stretch" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="#24313A" CornerRadius="8" Width="35" Height="35">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource ScrollIcon}" Stroke="#D3FA85" Width="17" Height="17"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ui.CaptureScrolling}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource Ui.ScrollingDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="ScrollShortcutLabel" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource ForwardIcon}" Grid.Column="2" Width="12" Height="12" Stroke="#818F9E" Margin="2,0,0,0"/>
                                </Grid>
                            </Button>
                    </UniformGrid>

                    <Border x:Name="HistoryHeader" Panel.ZIndex="1" Background="{StaticResource Window}"
                            Margin="0,15,0,0" Padding="0,8,0,9" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Stroke}">
                        <Border.RenderTransform><TranslateTransform x:Name="HistoryHeaderOffset"/></Border.RenderTransform>
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="HistorySearchBox" DockPanel.Dock="Right" Width="224" Height="34" CornerRadius="8"
                                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                    <Grid Margin="8,0,3,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource SearchIcon}" Stroke="{StaticResource Muted}" Width="14" Height="14" Margin="0,0,7,0"/>
                                        <TextBox x:Name="HistorySearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,0,3,0"
                                                 FontSize="13" VerticalContentAlignment="Center" TextChanged="HistorySearch_Changed"
                                                 KeyDown="HistorySearch_KeyDown" AutomationProperties.Name="{DynamicResource Ui.HistorySearch}"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Ui.HistorySearch}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button x:Name="HistorySearchClear" Grid.Column="2" Style="{StaticResource IconButton}" Width="25" Height="26"
                                                Padding="5" Visibility="Collapsed" Click="ClearHistorySearch_Click" ToolTip="{DynamicResource Ui.HistorySearchClear}"
                                                AutomationProperties.Name="{DynamicResource Ui.HistorySearchClear}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource CloseIcon}" Width="11" Height="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Ui.Recent}" FontWeight="Bold" FontSize="21" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HistoryCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="HistoryIndexStatus" Visibility="Collapsed" Style="{StaticResource MutedText}" FontSize="12"
                                       TextAlignment="Right" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="EmptyHistory" Background="#151C25" BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1" CornerRadius="12" Padding="17" MinHeight="74" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="37" Height="37" Background="#222D36" CornerRadius="9">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource CropIcon}" Stroke="#A3AEBC"/>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Ui.EmptyTitle}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EmptyDescription" Text="{DynamicResource Ui.EmptyDescription}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="HistoryCardsPanel" Margin="0,8,0,0" SizeChanged="HistoryCardsPanel_SizeChanged">
                    <Border x:Name="HistoryBeforeCards" Height="0"/>
                    <ItemsControl x:Name="HistoryItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemWidth="{x:Static local:HistoryViewport.TileWidth}" ItemHeight="{x:Static local:HistoryViewport.TileHeight}"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HistoryItem}">
                                <Grid Width="221" Height="160" Margin="0,0,10,10">
                                <Button x:Name="HistoryTile" Padding="0" Click="History_Click"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource HistoryMenu}" HasDropShadow="True" Closed="HistoryMenu_Closed"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource HistoryMenuItem}" Header="{DynamicResource Ui.Copy}" Click="CopyHistory_Click">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource CopyIcon}" Stroke="{StaticResource Muted}"
                                                          Width="13" Height="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource HistoryMenuItem}" Header="{DynamicResource Ui.HistoryRename}" Click="RenameHistory_Click">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource PenIcon}" Stroke="{StaticResource Muted}"
                                                          Width="13" Height="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource HistoryMenuItem}" Header="{DynamicResource Ui.Delete}" Click="DeleteHistory_Click">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource Icon}" Data="{StaticResource TrashIcon}" Stroke="{StaticResource Muted}"
                                                          Width="13" Height="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="103"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Margin="5" Background="{StaticResource Canvas}" CornerRadius="5">
                                                <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Loaded="HistoryThumbnail_Loaded" Unloaded="HistoryThumbnail_Unloaded"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="10,2,10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Dimensions}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Tag="{Binding ElementName=HistoryTile}" Click="OpenHistoryMenu_Click"
                                        Background="#EC17212C" BorderBrush="#536174" Foreground="{StaticResource Text}"
                                        Width="30" Height="27" Padding="6" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        ToolTip="{DynamicResource Ui.HistoryMenu}" AutomationProperties.Name="{DynamicResource Ui.HistoryMenu}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource MoreIcon}" Width="16" Height="4" StrokeThickness="2.5"/>
                                </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="HistoryAfterCards" Height="0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="EditorView" Grid.Row="1" Visibility="Collapsed" Margin="23,15,23,12">
                <Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
                <Grid x:Name="EditorHeader" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="EditorBackButton" Style="{StaticResource IconButton}" Height="37" Click="Home_Click"
                            ToolTip="{DynamicResource Ui.Back}" AutomationProperties.Name="{DynamicResource Ui.Back}"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource BackIcon}"/>
                    </Button>
                    <TextBlock x:Name="EditorHeading" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="{DynamicResource Ui.Editor}" FontSize="20" FontWeight="Bold"/>
                        <Run Text="&#x2002;·&#x2002;" Foreground="{StaticResource Muted}" FontSize="13"/>
                        <Run x:Name="ImageSize" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </TextBlock>
                    <StackPanel x:Name="EditorHeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Height="37" Margin="0,0,6,0" Click="Crop_Click"
                                ToolTip="{DynamicResource Ui.CropTip}" AutomationProperties.Name="{DynamicResource Ui.CropAction}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource CropIcon}"/>
                        </Button>
                        <Button x:Name="OcrButton" Click="Ocr_Click" ToolTip="{DynamicResource Ui.OcrTooltip}" AutomationProperties.Name="{DynamicResource Ui.OcrAction}"
                                Margin="0,0,6,0" Height="37">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource OcrIcon}"/>
                                <AccessText Text="{DynamicResource Ui.OcrAction}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Pin_Click" ToolTip="{DynamicResource Ui.Pin}"
                                AutomationProperties.Name="{DynamicResource Ui.Pin}" Height="37"><Path Style="{StaticResource Icon}" Data="{StaticResource PinIcon}" /></Button>
                        <Button Click="Save_Click" ToolTip="{DynamicResource Ui.SaveTooltip}" AutomationProperties.Name="{DynamicResource Ui.Save}" Margin="6,0,0,0" Height="37"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource SaveIcon}" /><AccessText Text="{DynamicResource Ui.Save}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource PrimaryButton}" Click="Copy_Click" ToolTip="{DynamicResource Ui.CopyTooltip}" AutomationProperties.Name="{DynamicResource Ui.Copy}" Margin="8,0,0,0" Height="37"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource CopyIcon}" /><AccessText Text="{DynamicResource Ui.Copy}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="EditorToolsPanel" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="12,12,0,0" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <DockPanel x:Name="EditorToolRow" Margin="8,6,8,7">
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource Ui.ToolsActions}" Style="{StaticResource ToolGroupTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click"
                                            ToolTip="{DynamicResource Ui.UndoTip}" AutomationProperties.Name="{DynamicResource Ui.Undo}"><Path Style="{StaticResource Icon}" Data="{StaticResource UndoIcon}"/></Button>
                                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="Redo_Click"
                                            ToolTip="{DynamicResource Ui.RedoTip}" AutomationProperties.Name="{DynamicResource Ui.Redo}"><Path Style="{StaticResource Icon}" Data="{StaticResource RedoIcon}"/></Button>
                                    <Button x:Name="DeleteAnnotationButton" Style="{StaticResource GhostButton}" Click="DeleteAnnotation_Click"
                                            Padding="8,6" Height="34" ToolTip="{DynamicResource Ui.DeleteAnnotationTip}" AutomationProperties.Name="{DynamicResource Ui.DeleteAnnotation}">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource TrashIcon}" Width="15" Height="15"/><AccessText Text="{DynamicResource Ui.Delete}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
