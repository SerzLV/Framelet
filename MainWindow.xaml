                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="ColorButtons" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#D3FA85"
