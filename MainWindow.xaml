                                            <TextBlock Text="{DynamicResource Ui.Color}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                            <Path Style="{StaticResource Icon}" Data="M3,5 L7,9 L11,5" Stroke="{StaticResource Muted}"
