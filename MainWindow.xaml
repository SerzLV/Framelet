                                            Value="4" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="Size_Changed" AutomationProperties.Name="{DynamicResource Ui.Thickness}"/>
