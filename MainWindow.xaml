                                            <Path Style="{StaticResource Icon}" Data="{StaticResource LineIcon}"/>
                                        </Button>
                                        <Button Style="{StaticResource EditorToolButton}" Tag="Rectangle" Click="Tool_Click"
                                        ToolTip="{DynamicResource Ui.RectangleTool}" AutomationProperties.Name="{DynamicResource Ui.RectangleTool}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource RectIcon}"/>
