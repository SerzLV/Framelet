                                                </StackPanel>
                                            </Button>
                                            <ItemsControl x:Name="OcrContacts">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="OcrContact_Click" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}"
                                                                HorizontalContentAlignment="Stretch" Margin="0,0,0,5" Padding="8,5">
                                                            <DockPanel>
                                                                <Path DockPanel.Dock="Right" Width="13" Height="13" Margin="7,0,0,0">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                                            <Setter Property="Data" Value="{StaticResource CopyIcon}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Copied">
                                                                                    <Setter Property="Data" Value="{StaticResource CheckIcon}"/>
                                                                                    <Setter Property="Stroke" Value="{StaticResource Accent}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
