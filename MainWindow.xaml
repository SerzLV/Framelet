                                    <Ellipse Width="14" Height="14" Fill="#D3FA85" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#FF656F"
                                        Click="Color_Click" ToolTip="{DynamicResource Ui.Red}" AutomationProperties.Name="{DynamicResource Ui.Red}">
                                    <Ellipse Width="14" Height="14" Fill="#FF656F" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#FFCC66"
                                        Click="Color_Click" ToolTip="{DynamicResource Ui.Yellow}" AutomationProperties.Name="{DynamicResource Ui.Yellow}">
                                    <Ellipse Width="14" Height="14" Fill="#FFCC66" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#75CFFF"
                                        Click="Color_Click" ToolTip="{DynamicResource Ui.Cyan}" AutomationProperties.Name="{DynamicResource Ui.Cyan}">
                                    <Ellipse Width="14" Height="14" Fill="#75CFFF" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#3456FA"
                                        Click="Color_Click" ToolTip="{DynamicResource Ui.Blue}" AutomationProperties.Name="{DynamicResource Ui.Blue}">
                                    <Ellipse Width="14" Height="14" Fill="#3456FA" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#FFFFFF"
                                        Click="Color_Click" ToolTip="{DynamicResource Ui.White}" AutomationProperties.Name="{DynamicResource Ui.White}">
                                    <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="29" Height="29" Padding="5" Tag="#17201A"
                                        Click="Color_Click" ToolTip="{DynamicResource Ui.Black}" AutomationProperties.Name="{DynamicResource Ui.Black}">
                                    <Ellipse Width="14" Height="14" Fill="#17201A" Stroke="#637181" StrokeThickness=".7"/>
                                </Button>
                                    </StackPanel>
                                    <Border Width="1" Height="19" Background="{StaticResource Stroke}" Margin="9,0"/>
                                    <TextBlock x:Name="StrokeCaption" Text="{DynamicResource Ui.Thickness}" Style="{StaticResource MutedText}"
                                               FontSize="12" Margin="0,0,9,0" VerticalAlignment="Center"/>
