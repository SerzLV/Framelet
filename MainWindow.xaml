                                                        <Style.Triggers>
                                                            <Trigger Property="Tag" Value="Copied">
                                                                <Setter Property="Content" Value="{DynamicResource Ui.Copied}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="{DynamicResource Ui.OcrAllText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBox x:Name="OcrText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 FontSize="13" MinHeight="106" MaxHeight="206" AutomationProperties.Name="{DynamicResource Ui.OcrRecognized}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
                <DockPanel x:Name="EditorFooter" Grid.Row="3" Margin="0,5,0,0">
