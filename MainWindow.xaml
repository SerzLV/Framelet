                                        </Button>
                                        <Button Style="{StaticResource EditorToolButton}" Tag="Number" Click="Tool_Click"
                                        ToolTip="{DynamicResource Ui.NumberTool}" AutomationProperties.Name="{DynamicResource Ui.NumberTool}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource NumberIcon}"/>
                                        </Button>
                                        <Button Style="{StaticResource EditorToolButton}" Tag="Redact" Click="Tool_Click"
                                        ToolTip="{DynamicResource Ui.RedactTool}" AutomationProperties.Name="{DynamicResource Ui.RedactTool}">
