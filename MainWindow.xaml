                                        <TextBlock x:Name="StrokeValue" Text="4" TextAlignment="Center" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ActiveToolText" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
