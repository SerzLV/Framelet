                                    Click="WorkspaceShortcut_Click" ToolTip="{DynamicResource Ui.WorkspaceShortcutHint}"
                                    AutomationProperties.Name="{DynamicResource Ui.WorkspaceShortcutTitle}"/>
                            <TextBlock Text="{DynamicResource Ui.WorkspaceShortcutTitle}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </DockPanel>
                        <TextBlock x:Name="WorkspaceShortcutStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
                        <Border Height="1" Background="{StaticResource Stroke}" Margin="0,15"/>
                        <CheckBox x:Name="HistorySetting" Content="{DynamicResource Ui.KeepHistory}" Margin="0,0,0,7" Click="Preferences_Click"/>
                        <TextBlock Text="{DynamicResource Ui.HistoryArchiveHint}" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Ui.HistorySourceNote}" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{DynamicResource Ui.StorageFolderTitle}" FontWeight="SemiBold" Margin="0,13,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Ui.ChooseStorageFolder}"
                                    Padding="9,6" Margin="8,0,0,0" Click="ChooseStorageFolder_Click"/>
                            <Border CornerRadius="7" Background="{StaticResource Canvas}" Padding="9,4">
                                <TextBlock x:Name="StorageFolderPath" FontSize="12" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.Name="{DynamicResource Ui.StorageFolderTitle}"/>
                            </Border>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Ui.OpenFolder}" Click="OpenHistoryFolder_Click"/>
                            <Button x:Name="ResetStorageFolderButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Ui.ResetStorageFolder}"
                                    Click="ResetStorageFolder_Click" Margin="4,0,0,0"/>
                            <Button x:Name="ClearHistoryButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Ui.ClearHistory}" Click="ClearHistory_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="ClearConfirmation" Background="{StaticResource Canvas}" Padding="11" CornerRadius="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Ui.ClearHistory}" Click="ConfirmClearHistory_Click"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Ui.Cancel}" Click="CancelClearHistory_Click" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Ui.DeleteConfirm}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

