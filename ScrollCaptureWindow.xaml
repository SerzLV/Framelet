<Window x:Class="Framelet.ScrollCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="{DynamicResource Ui.CaptureScrolling}"
        Width="420" SizeToContent="Height" ShowActivated="False" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}" UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown">
    <Border Padding="14,12" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <StackPanel>
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="27" Height="26" Padding="5"
                        Click="Cancel_Click" AutomationProperties.Name="{DynamicResource Ui.Cancel}">
                    <Button.ToolTip><ToolTip Content="{DynamicResource Ui.Cancel}"/></Button.ToolTip>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource CloseIcon}"/>
                </Button>
                <DockPanel x:Name="DragHeader" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
                    <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource ScrollIcon}" Width="16" Height="16"
                          Stroke="{StaticResource Accent}" Margin="0,0,8,0"/>
                    <Path DockPanel.Dock="Right" Width="10" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"
                          Stroke="{StaticResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M2,2 H8 M2,6 H8 M2,10 H8"/>
                    <TextBlock Text="{DynamicResource Ui.CaptureScrolling}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
            </DockPanel>
            <DockPanel Margin="0,8,0,10">
                <Border x:Name="FramePreview" DockPanel.Dock="Left" Width="70" Height="49" Margin="0,0,10,0" Padding="3" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{StaticResource Stroke}" Background="{StaticResource Canvas}">
                    <Border.ToolTip><ToolTip Content="{DynamicResource Ui.ScrollPreview}"/></Border.ToolTip>
                    <Image x:Name="LastFrame" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CaptureProgress" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Text="{DynamicResource Ui.ScrollFirstFrame}" FontSize="12"
                               Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="CaptureInstructions" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,12"/>
            <Button x:Name="TailButton" Content="{DynamicResource Ui.ScrollTailAdd}" Click="AddTail_Click"
                    HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="FinishButton" Content="{DynamicResource Ui.ScrollFinish}" Click="Finish_Click" Margin="0,0,7,0"/>
                <Button x:Name="AddFrame" Content="{DynamicResource Ui.ScrollAddFrame}" Click="AddFrame_Click" Margin="0,0,7,0"/>
                <Button x:Name="AutoScrollButton" Style="{StaticResource PrimaryButton}" Click="AutoScroll_Click" MinWidth="116"
                        Content="{DynamicResource Ui.ScrollAuto}">
                    <Button.ToolTip><ToolTip Content="{DynamicResource Ui.ScrollAutoTip}"/></Button.ToolTip>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
