        <Geometry x:Key="WindowIcon">M2,3 H18 V17 H2 Z M2,7 H18 M5,5 H5.4 M8,5 H8.4</Geometry>
        <Geometry x:Key="TimerIcon">M17,11 A7,7 0 1 1 3,11 A7,7 0 1 1 17,11 M10,7 V11 L12.5,13 M8,1 H12 M15,4 L17,2</Geometry>
        <Geometry x:Key="ScrollIcon">M3,3 H13 V17 H3 Z M6,7 H10 M6,10 H10 M6,13 H9 M17,4 V16 M14.5,13.5 L17,16 L19.5,13.5</Geometry>
