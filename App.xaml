        <Geometry x:Key="BackIcon">M15,10 H4 M9,5 L4,10 L9,15</Geometry>
        <Geometry x:Key="ForwardIcon">M4,10 H15 M10,5 L15,10 L10,15</Geometry>
        <Geometry x:Key="LaunchIcon">M11,3 H17 V9 M17,3 L8,12 M8,4 H3 V17 H16 V12</Geometry>
        <Geometry x:Key="PowerIcon">M10,2 V9 M6,4.5 A7,7 0 1 0 14,4.5</Geometry>
