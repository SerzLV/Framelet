        <Geometry x:Key="NumberIcon">M18,10 A8,8 0 1 1 2,10 A8,8 0 1 1 18,10 M8,8 L10,6 V14 M8,14 H12</Geometry>
        <Geometry x:Key="RedactIcon">M2,4 H18 V16 H2 Z M5,8 H15 M5,10 H15 M5,12 H15</Geometry>
        <Geometry x:Key="CloseIcon">M5,5 L15,15 M5,15 L15,5</Geometry>
        <Geometry x:Key="CheckIcon">M4,10 L8,14 L16,6</Geometry>
    </Application.Resources>
</Application>
