        <Geometry x:Key="CurveIcon">M3,15 C10,20 7,1 17,6 M13,7 L17,6 L16,2</Geometry>
        <Geometry x:Key="RectIcon">M3,4 H17 V16 H3 Z</Geometry>
        <Geometry x:Key="EllipseIcon">M17,10 A7,6 0 1 1 3,10 A7,6 0 1 1 17,10 Z</Geometry>
